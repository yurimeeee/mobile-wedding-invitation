rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /invitations/{invitationId} {
      // 발행된 청첩장은 누구나 읽기 가능 (공개 링크 공유용)
      allow read: if resource.data.status == 'published';
      // 본인의 청첩장은 임시저장 포함 읽기 가능
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      // 본인만 쓰기 가능
      allow write: if request.auth != null && request.auth.uid == resource.data.uid;
      // 새 문서 생성 (uid 일치)
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;

      // 방명록(축하 메시지): 발행된 청첩장에는 하객이 로그인 없이 남길 수 있고,
      // 소유자는 임시저장 상태에서도 확인/삭제 가능
      match /messages/{messageId} {
        function invitation() {
          return get(/databases/$(database)/documents/invitations/$(invitationId)).data;
        }
        function isOwner() {
          return request.auth != null && request.auth.uid == invitation().uid;
        }
        allow read, create: if invitation().status == 'published' || isOwner();
        allow delete: if invitation().status == 'published' || isOwner();
      }
    }
  }
}
