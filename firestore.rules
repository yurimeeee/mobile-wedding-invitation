rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }
    function bootstrapUsed() {
      return exists(/databases/$(database)/documents/adminMeta/bootstrap);
    }
    // 발행 상태이면서, 자동 만료(expiresAt)가 설정되지 않았거나 아직 지나지 않은 청첩장만
    // 공개로 취급한다. 소유자 본인의 read/write에는 적용하지 않는다(꺼서 재공개할 수 있어야 함).
    function isPublished(inv) {
      return inv.status == 'published' &&
        (inv.get('expiresAt', null) == null || request.time < inv.expiresAt);
    }

    // 관리자 계정 (문서 ID = uid)
    match /adminUsers/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if request.auth != null && (
        // 기존 관리자가 새 관리자를 추가
        (
          isAdmin() &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.role == 'admin' &&
          request.resource.data.keys().hasAll(['email', 'name', 'role', 'createdAt', 'createdBy'])
        ) ||
        // 부트스트랩: 관리자가 한 명도 없을 때, adminMeta/bootstrap 생성과 같은 배치일 때만 허용
        (
          uid == request.auth.uid &&
          !bootstrapUsed() &&
          existsAfter(/databases/$(database)/documents/adminMeta/bootstrap) &&
          request.resource.data.createdBy == null &&
          request.resource.data.role == 'admin' &&
          request.resource.data.keys().hasAll(['email', 'name', 'role', 'createdAt', 'createdBy'])
        )
      );

      allow update, delete: if false;
    }

    // 사용자가 직접 업로드한 커스텀 요소(스티커/이미지) — 업로드한 본인만 읽고 쓸 수 있다
    match /users/{uid}/customElements/{elementId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 부트스트랩 완료 여부 플래그 (단일 문서)
    match /adminMeta/bootstrap {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        !bootstrapUsed() &&
        request.resource.data.initializedBy == request.auth.uid &&
        request.resource.data.keys().hasAll(['initializedBy', 'initializedAt']) &&
        existsAfter(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
      allow update, delete: if false;
    }

    match /invitations/{invitationId} {
      // 발행된 청첩장은 누구나 읽기 가능 (공개 링크 공유용, 자동 만료 전까지만)
      allow read: if isPublished(resource.data);
      // 본인의 청첩장은 임시저장 포함, 만료 여부와 무관하게 항상 읽기 가능
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      // 본인만 쓰기 가능
      allow write: if request.auth != null && request.auth.uid == resource.data.uid;
      // 새 문서 생성 (uid 일치)
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;

      // 방명록(축하 메시지): 발행된 청첩장에는 하객이 로그인 없이 남길 수 있고,
      // 소유자는 임시저장 상태에서도 확인/삭제 가능
      match /messages/{messageId} {
        function invitation() {
          return get(/databases/$(database)/documents/invitations/$(invitationId)).data;
        }
        function isOwner() {
          return request.auth != null && request.auth.uid == invitation().uid;
        }
        function isValidMessage() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'passwordHash', 'salt', 'contents', 'secret', 'createdAt']) &&
            d.keys().hasAll(['name', 'passwordHash', 'contents', 'createdAt']) &&
            d.name is string && d.name.size() > 0 && d.name.size() <= 50 &&
            d.passwordHash is string && d.passwordHash.size() <= 128 &&
            d.get('secret', false) is bool &&
            d.contents is string && d.contents.size() <= 500 &&
            // 비밀글은 실제 내용을 이 문서에 담지 않는다(아래 private/content 참고) — 그래서
            // contents가 비어 있어야 하고, 일반 글은 반대로 비어 있으면 안 된다.
            (d.get('secret', false) == true ? d.contents.size() == 0 : d.contents.size() > 0) &&
            d.createdAt == request.time;
        }
        allow read: if isPublished(invitation()) || isOwner();
        allow create: if (isPublished(invitation()) || isOwner()) && isValidMessage();
        // 하객의 삭제는 비밀번호를 대조해야 하는데 규칙에서는 passwordHash를 직접 비교할
        // 방법이 없다(해시 함수 없음). 그래서 공개 delete는 막고 /api/guest-message
        // 라우트에서 Admin SDK로 비밀번호를 확인한 뒤 대신 삭제한다.
        allow delete: if isOwner();

        // 비밀글의 실제 내용. 위 messages 문서는 발행된 청첩장이면 누구나 읽을 수 있으므로
        // (하객 공개 열람용), contents를 그대로 두면 devtools로 노출된다. 그래서 비밀글의
        // 내용만 소유자만 읽을 수 있는 이 서브문서로 분리한다 — 작성 자체는 방명록 작성과
        // 같은 조건(발행된 청첩장 또는 소유자)으로 허용하되, 읽기는 소유자만 가능하다.
        match /private/content {
          function isValidContent() {
            let d = request.resource.data;
            return d.keys().hasOnly(['contents']) &&
              d.contents is string && d.contents.size() > 0 && d.contents.size() <= 500;
          }
          allow read, update, delete: if isOwner();
          allow create: if (isPublished(invitation()) || isOwner()) && isValidContent();
        }
      }

      // /api/guest-message 라우트가 IP별 삭제 시도 빈도를 세는 용도 — Admin SDK로만 접근.
      match /messageDeleteAttempts/{ipHash} {
        allow read, write: if false;
      }

      // 참석여부 응답: 하객의 공개 제출은 요청 빈도를 제한할 수 있는 /api/rsvp 라우트를
      // 통해서만(Admin SDK로 우회) 저장한다 — 규칙은 문서 하나의 유효성만 볼 수 있어 봇이
      // 반복 제출하는 것을 막을 수 없기 때문. 그래서 클라이언트 직접 create는 소유자만 허용한다.
      // 다른 하객의 응답 내용은 볼 수 없고 소유자만 확인/삭제 가능
      match /rsvps/{rsvpId} {
        function invitation() {
          return get(/databases/$(database)/documents/invitations/$(invitationId)).data;
        }
        function isOwner() {
          return request.auth != null && request.auth.uid == invitation().uid;
        }
        function isValidRSVP() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'side', 'attending', 'guestCount', 'mealAttending', 'companions', 'phone', 'createdAt']) &&
            d.keys().hasAll(['name', 'side', 'attending', 'guestCount', 'mealAttending', 'companions', 'phone', 'createdAt']) &&
            d.name is string && d.name.size() > 0 && d.name.size() <= 50 &&
            d.side in ['groom', 'bride'] &&
            d.attending is bool &&
            d.guestCount is int && d.guestCount >= 0 && d.guestCount <= 50 &&
            d.mealAttending is bool &&
            d.companions is string && d.companions.size() <= 200 &&
            d.phone is string && d.phone.size() <= 30 &&
            d.createdAt == request.time;
        }
        allow create: if isOwner() && isValidRSVP();
        allow read, delete: if isOwner();
      }

      // /api/rsvp 라우트가 IP별 제출 빈도를 세는 용도 — 소유자를 포함해 클라이언트에서는
      // 직접 읽거나 쓸 수 없고 Admin SDK로만 접근한다.
      match /rsvpRateLimits/{ipHash} {
        allow read, write: if false;
      }

      // 청첩장 잠금 비밀번호. invitations/{id} 문서는 발행 시 누구나 읽을 수 있으므로,
      // 비밀번호를 그 문서에 두면 하객이 devtools로 Firestore를 직접 읽어 평문 비밀번호를
      // 볼 수 있다. 그래서 별도 서브문서로 분리해 소유자만 읽고 쓸 수 있게 하고, 하객의
      // 잠금 해제 확인은 /api/invitation-lock 라우트에서 Admin SDK로만 처리한다.
      match /private/{docId} {
        function invitation() {
          return get(/databases/$(database)/documents/invitations/$(invitationId)).data;
        }
        function isOwner() {
          return request.auth != null && request.auth.uid == invitation().uid;
        }
        allow read, write: if isOwner();
      }

      // /api/invitation-lock 라우트가 IP별 비밀번호 시도 빈도를 세는 용도 — Admin SDK로만 접근.
      match /lockAttempts/{ipHash} {
        allow read, write: if false;
      }

      // 저장/발행 시점마다 남는 버전 스냅샷 — 소유자만 접근 가능
      match /versions/{versionId} {
        function invitation() {
          return get(/databases/$(database)/documents/invitations/$(invitationId)).data;
        }
        function isOwner() {
          return request.auth != null && request.auth.uid == invitation().uid;
        }
        allow read, write: if isOwner();
      }
    }
  }
}
